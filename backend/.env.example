# Copia este archivo como .env solo para pruebas en tu ordenador y arranca con: npm run dev
# En Railway, estas variables se ponen en la pestaña "Variables".
# Base de datos: PostgreSQL directo (las tablas se crean solas al arrancar)...
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/yosoylisto
# ...o, en su lugar, Supabase:
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_KEY=pega-aqui-la-service-role-key
ADMIN_KEY=una-contraseña-larga-inventada
# Opcional: tu dominio final, para el sitemap (por ejemplo https://yosoylisto.es)
PUBLIC_URL=
